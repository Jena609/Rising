# Rising public configuration.
# Leave the contract address blank to stay in Demo Mode for contract actions.
# Never put a private key, seed phrase, or other secret in this file.
# NEXT_PUBLIC variables are sent to the browser.

# This version is GenLayer Studio Next only. Canonical name: studio-dev.
# Do not set chain ID 4221 (Bradbury), 61999 (Studionet), or 61127 (Localnet).
NEXT_PUBLIC_GENLAYER_NETWORK_NAME=GenLayer Studio Next
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_NATIVE_CURRENCY_NAME=GEN
NEXT_PUBLIC_GENLAYER_NATIVE_CURRENCY_SYMBOL=GEN
# GenLayerJS formats GEN with 18 decimal places.
NEXT_PUBLIC_GENLAYER_NATIVE_DECIMALS=18
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio-dev.genlayer.com
# Optional. Only a https://explorer-studio-dev.genlayer.com template containing {hash} is used.
# If this is empty, Rising shows the hash and the explorer home URL, and does not invent a path.
NEXT_PUBLIC_GENLAYER_EXPLORER_TX_URL_TEMPLATE=
# Leave blank. GenLayer does not publish a separate Studio Next faucet URL.
# The faucet is the account-selector button at https://studio-dev.genlayer.com
NEXT_PUBLIC_GENLAYER_FAUCET_URL=
# Leave blank until the Rising Intelligent Contract is deployed on Studio Next.
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=
# JSON array, or an object with an "abi" array. Overrides src/config/contract-abi.json.
NEXT_PUBLIC_GENLAYER_ABI=
# Set to true only when genlayer-js should submit and read Intelligent Contract calls.
NEXT_PUBLIC_GENLAYER_INTEGRATION_ENABLED=true
